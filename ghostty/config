font-family = Maple Mono
font-family-bold = Maple Mono
font-family-italic = Maple Mono
font-family-bold-italic = Maple Mono
font-style = Italic
font-style-bold = Italic
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 12

# Adventure, Mathias
theme = Catppuccin Mocha
background-opacity = .85
background-blur = 15

cursor-style = bar
cursor-style-blink = true

mouse-hide-while-typing = true


link-url = true

window-title-font-family = Maple Mono Italic
window-new-tab-position = current
window-theme = auto
maximize = true

# open window in maximized screen (fullscreen but with the bar)
window-width = 9999
window-height = 9999
#fullscreen = true
#window-decoration = false

#macos-window-buttons = hidden
macos-titlebar-style = tabs
macos-icon = retro
macos-icon-frame = beige
macos-non-native-fullscreen = visible-menu

# disable fullscreen binding
#keybind = ctrl+cmd+f=ignore
keybind = cmd+enter=ignore

# Cursor settings
selection-foreground = #00d4ff
selection-background = #264f78
cursor-color = #4a9eff

shell-integration-features = true

macos-titlebar-style = tabs
macos-option-as-alt = true
macos-auto-secure-input = true
macos-secure-input-indication = true

auto-update = check

# Window padding (in pixels)
window-padding-x = 2
window-padding-y = 0
window-padding-balance = true

confirm-close-surface = false
confirm-close-surface =  false
